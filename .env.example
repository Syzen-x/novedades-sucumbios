# Copia este archivo como .env en el servidor y completa los valores.

# Dominio sin https:// (por ejemplo: novedadessucumbios.com)
DOMINIO=novedadessucumbios.com

# Dirección pública completa del sitio (se usa en Google, Facebook y el mapa del sitio)
SITIO_URL=https://novedadessucumbios.com

NODE_ENV=production
