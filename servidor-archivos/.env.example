# Copia este archivo como .env en el VPS.

# Dominio principal (sin https://)
DOMINIO=novedadessucumbios.com

# Clave compartida con Cloudflare (la misma que `wrangler secret put MEDIA_SECRETO`).
# Genera una con:  openssl rand -hex 32
MEDIA_SECRETO=

# Desde dónde se permite subir (el panel)
ORIGENES=https://novedadessucumbios.com,https://www.novedadessucumbios.com
